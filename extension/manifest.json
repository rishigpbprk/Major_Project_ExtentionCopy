{
  "manifest_version": 3,
  "name": "AI Content Safety Barrier - Automatic",
  "version": "3.0.0",
  "description": "Automatic pre-post AI text and deepfake video safety barrier.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "AI Content Safety Barrier"
  }
}